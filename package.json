{
  "name": "ptcl-productflow-360",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "playwright test --project=chromium",
    "test:ui": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:regression": "playwright test --grep @regression --project=chromium",
    "test:api": "playwright test playwright/tests/api --project=chromium",
    "api:build": "npm run build --workspace apps/api",
    "api:dev": "npm run dev --workspace apps/api"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
